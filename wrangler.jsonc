// Cloudflare Workers + D1 配置（analytics）
// 敏感变量（CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID / EXPORT_KEY）以 Worker Secret 方式设置，勿写入本文件：
//   echo "$CLOUDFLARE_API_TOKEN" | npx wrangler secret put CLOUDFLARE_API_TOKEN
//   echo "$CLOUDFLARE_ACCOUNT_ID" | npx wrangler secret put CLOUDFLARE_ACCOUNT_ID
//   echo "$EXPORT_KEY" | npx wrangler secret put EXPORT_KEY
// 部署时账户 ID 通过 --account-id 传入，避免明文入库：
//   npx wrangler deploy --account-id "$CLOUDFLARE_ACCOUNT_ID"
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "analytics",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "vars": {
    "APP_NAME": "网站流量分析"
  },
  "triggers": {
    "crons": ["5 0 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "analytics",
      "database_id": "eb27195e-e717-4573-be52-b3b7da0aea9f"
    }
  ],
  "observability": {
    "enabled": true
  }
}