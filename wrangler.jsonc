// Cloudflare Workers + D1 配置（dev 分支）
// 敏感变量（CLOUDFLARE_API_TOKEN / EXPORT_KEY）以 Worker Secret 方式设置，勿写入本文件：
//   echo "$CLOUDFLARE_API_TOKEN" | npx wrangler secret put CLOUDFLARE_API_TOKEN
//   echo "$EXPORT_KEY" | npx wrangler secret put EXPORT_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-analytics-dev",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "vars": {
    "APP_NAME": "Cloudflare 网站流量分析 (dev)"
  },
  "triggers": {
    "crons": ["5 0 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-analytics-dev-db",
      "database_id": "fdca190d-dbc8-4a1a-967a-e9480b1b34f6"
    }
  ],
  "observability": {
    "enabled": true
  }
}